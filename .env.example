# Copy this file to .env and fill in values for local development.
# .env is sourced automatically by scripts/bootstrap.sh.
# Never commit .env — it is gitignored.

# Required: GitHub personal access token with repo + packages:read/write scopes
GITHUB_TOKEN=

# Infisical credentials — only required when using the infisical backend
# INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
# INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=

# App-specific secrets for the kubernetes backend.
# Add one block per app that needs secrets seeded into the local-secrets namespace.
# Mirror these in the SECRETS_ARGS section of scripts/bootstrap.sh.
#
# Example:
# MY_APP_API_KEY=
# MY_APP_API_SECRET=
